# Microsoft Foundry Configuration
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
FOUNDRY_AGENT_NAME=Campus-Placement-Assistant

# Microsoft Entra External ID Backend Configuration (Token Validation)
ENTRA_CLIENT_ID=<your-entra-application-client-id>
ENTRA_AUTHORITY=https://<your-tenant-name>.ciamlogin.com/<your-tenant-id>/v2.0
ENTRA_TENANT_ID=<your-tenant-id>
# Optional overrides:
# ENTRA_ISSUER=https://<your-tenant-name>.ciamlogin.com/<your-tenant-id>/v2.0
# ENTRA_JWKS_URL=https://<your-tenant-name>.ciamlogin.com/<your-tenant-id>/discovery/v2.0/keys
# Set to false only during early local offline development:
REQUIRE_AUTH=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
